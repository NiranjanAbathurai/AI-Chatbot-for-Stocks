# Stock Debate Chat — Environment Variables
# Copy this file to .env for local development with `netlify dev`
# For production, set these in Netlify Dashboard → Site settings → Environment variables

# AI Provider API Keys (at least one required)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# AI Provider Priority (optional, default: gemini,openai,groq)
# AI_PROVIDER_PRIORITY=gemini,openai,groq
