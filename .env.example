# Stock Debate Chat — Environment Variables
# Copy this file to .env for local development with `netlify dev`
# For production, set these in Netlify Dashboard → Site settings → Environment variables

# AI Provider API Keys (at least one required)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# AI Provider Priority (optional, default: gemini,openai,groq)
# AI_PROVIDER_PRIORITY=gemini,openai,groq

# Model Overrides (optional — leave unset to use automatic fallback)
# The app tries a ranked list of models automatically. If a model is
# deprecated, the next one in the list is used. Set these only if you
# want to force a specific model.
# GEMINI_MODEL=gemini-2.5-flash-preview-05-20
# OPENAI_MODEL=gpt-4o-mini
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
