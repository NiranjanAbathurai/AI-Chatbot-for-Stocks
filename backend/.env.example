# AI Providers - at least one required (Gemini and Groq are FREE)
GEMINI_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_groq_key_here

# Optional paid providers (uncomment and add keys if you have them)
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here

# App Config
# Default priority uses free providers. Add openai/anthropic if you have paid keys.
AI_PROVIDER_PRIORITY=gemini,groq
BACKEND_PORT=8000

# Stock Data Source
# "google_finance" (default) — scrapes Google Finance, works behind corporate proxies
# "yfinance"                 — uses yfinance library (may hang behind Zscaler)
# "auto"                     — tries Google Finance first, falls back to yfinance
STOCK_DATA_SOURCE=google_finance

# Model Overrides (optional — leave unset to use automatic fallback)
# The app tries a ranked list of models automatically. If a model is
# deprecated, the next one in the list is used. Set these only if you
# want to force a specific model.
# GEMINI_MODEL=gemini-2.5-flash-preview-05-20
# OPENAI_MODEL=gpt-4o-mini
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Phase 3: Alerts - optional
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
ALERT_SCAN_INTERVAL_HOURS=4
